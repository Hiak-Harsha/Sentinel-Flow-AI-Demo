# ==============================================================================
# Sentinel Flow — Environment Configuration Template
# Copy this file to .env and adjust variables for your deployment environment.
# ==============================================================================

# Application Environment: 'development' or 'production'
# In production, default secrets are strictly rejected at startup.
SENTINEL_ENV=development
PORT=8000

# CORS Allowed Origins (comma-separated list of browser origins)
SENTINEL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Safety Boundary: Target URL (Must pass RFC1918 / loopback allowlist)
SENTINEL_TARGET_URL=http://127.0.0.1:8000/lab-target
SENTINEL_PROXY_TIMEOUT=30.0

# Operator & Secret Keys
# WARNING: Change all default values in production environments.
SENTINEL_OPERATOR_PASSCODE=SF-OPERATOR-2026
SENTINEL_OPERATOR_SECRET=sentinel-operator-hmac-key-2026
SENTINEL_WEBHOOK_SECRET=sentinel-lab-webhook-secret-2026

# Frontend Client Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
